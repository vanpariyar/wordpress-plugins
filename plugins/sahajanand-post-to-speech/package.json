{
	"name": "sahajanand-post-to-speech",
	"version": "1.0.2",
	"description": "Sahajanand Post to Speech — convert WordPress posts to speech and embed an audio player with a Gutenberg block.",
	"author": "Ronak Sahajanand",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"copy:vendor": "node copy-vendor-assets.js",
		"build": "npm run copy:vendor && wp-scripts build",
		"postinstall": "npm run copy:vendor",
		"start": "wp-scripts start",
		"test": "wp-scripts test-unit-js",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:debug": "wp-scripts test-playwright --debug",
		"test:e2e:headed": "wp-scripts test-playwright --headed",
		"test:e2e:wp-6.9": "WP_ENV_CORE=https://wordpress.org/wordpress-6.9.5.zip wp-env start --update && WP_ENV_CORE=https://wordpress.org/wordpress-6.9.5.zip wp-scripts test-playwright",
		"test:e2e:wp-trunk": "WP_ENV_CORE=WordPress/WordPress#master wp-env start --update && WP_ENV_CORE=WordPress/WordPress#master wp-scripts test-playwright",
		"wp-env": "wp-env",
		"lint:js": "wp-scripts lint-js",
		"format": "wp-scripts format"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@wordpress/e2e-test-utils-playwright": "^1.51.0",
		"@wordpress/env": "^10.39.0",
		"@wordpress/scripts": "^30.0.0",
		"espeak-ng": "^1.0.2",
		"fflate": "^0.8.2",
		"npyjs": "^0.6.0",
		"onnxruntime-web": "^1.20.1"
	}
}
